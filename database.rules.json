{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner')"
      }
    },
    "ads": {
      ".read": true,
      ".indexOn": [
        "userId",
        "category_id",
        "timestamp"
      ],
      "$adId": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && (data.child('userId').val() === auth.uid || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))))",
        ".validate": "!newData.exists() || (newData.hasChildren(['userId','category_id','description','price','timestamp']) && newData.child('description').isString() && newData.child('description').val().length <= 2000 && newData.child('price').isNumber())"
      }
    },
    "حالة_الإعلانات": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')"
    },
    "ads_status": {
      "$adId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || root.child('ads').child($adId).child('userId').val() === auth.uid || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))",
        ".validate": "!newData.exists() || (newData.child('status').isString() && newData.child('status').val().length <= 20)"
      }
    },
    "direct_chats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.contains(auth.uid) || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))",
        "$msgId": {
          ".write": "auth != null && $chatId.contains(auth.uid) && !data.exists()",
          ".validate": "newData.hasChildren(['senderId','text','timestamp']) && newData.child('senderId').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 1500"
        }
      }
    },
    "chats": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))",
        ".write": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))"
      }
    },
    "subscriptions": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')",
      "$subId": {
        ".read": "auth != null && data.child('merchantId').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('merchantId').val() === auth.uid && newData.child('status').val() === 'pending') || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))",
        ".validate": "!newData.exists() || (newData.hasChildren(['merchantId','transactionRef','subType','status','timestamp']) && (!newData.child('receiptImg').exists() || newData.child('receiptImg').val().length < 900000))"
      }
    },
    "merchants": {
      "$mid": {
        ".read": "auth != null && (auth.uid === $mid || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')"
      }
    },
    "merchants_verified_registry": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')"
    },
    "temp_merchant_selections": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admin_settings": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')",
      "prices": {
        ".read": true
      }
    },
    "premium_ads": {
      ".read": true,
      "$adId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')",
        ".validate": "!newData.exists() || (newData.hasChild('until') && newData.child('until').isNumber())"
      }
    },
    "reports": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin')",
      "$rid": {
        ".write": "auth != null && (!data.exists() || (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === 'owner' || root.child('admins').child(auth.uid).val() === 'admin'))",
        ".validate": "!newData.exists() || (newData.hasChildren(['adId','reason','by','timestamp']) && newData.child('by').val() === auth.uid && newData.child('reason').isString() && newData.child('reason').val().length <= 300)"
      }
    }
  }
}